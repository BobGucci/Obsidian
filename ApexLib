                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromScale(0.5, 0.5),
                        Size = UDim2.fromOffset(50, 16),
                        BackgroundTransparency = 1,
                        Text = tostring(config.Default),
                        TextSize = 12,
                        Parent = Track,
                    })
                    
                    function Slider:SetValue(value, silent)
                        value = Utils:Clamp(value, self.Min, self.Max)
                        self.Value = value
                        
                        local percent = (value - self.Min) / (self.Max - self.Min)
                        Fill.Size = UDim2.fromScale(percent, 1)
                        
                        local displayText = config.Prefix .. Utils:Round(value, config.Rounding) .. config.Suffix
                        ValueLabel.Text = displayText
                        
                        if not silent then
                            ErrorHandler:SafeCall(self.Callback, value)
                        end
                    end
                    
                    -- Input handling
                    local dragging = false
                    
                    Track.InputBegan:Connect(function(input)
                        if Utils:IsClick(input) then
                            dragging = true
                            local function update()
                                local absPos = Track.AbsolutePosition.X
                                local absSize = Track.AbsoluteSize.X
                                local mouseX = APEX._SERVICES.UserInputService:GetMouseLocation().X
                                
                                local percent = Utils:Clamp((mouseX - absPos) / absSize, 0, 1)
                                local value = self.Min + (percent * (self.Max - self.Min))
                                self:SetValue(value)
                            end
                            update()
                            
                            while dragging do
                                update()
                                APEX._SERVICES.RunService.RenderStepped:Wait()
                            end
                        end
                    end)
                    
                    APEX._SERVICES.UserInputService.InputEnded:Connect(function(input)
                        if Utils:IsClick(input) then
                            dragging = false
                        end
                    end)
                    
                    Slider:SetValue(config.Default, true)
