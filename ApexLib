local NotificationSystem = {}
do
    local NotificationContainer = nil
    local ActiveNotifications = {}
    
    function NotificationSystem:Init()
        if NotificationContainer then return end
        
        NotificationContainer = Creator:New("Frame", {
            Name = "Notifications",
