        function Window:Minimize()
            if self.IsMinimized then return end
            self.IsMinimized = true
            
            AnimationSystem:Play(self.MainFrame, 0.3, {
                Size = UDim2.fromOffset(self.MainFrame.Size.X.Offset, 50),
            }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            
            Sidebar.Visible = false
            ContentArea.Visible = false
        end
        
        function Window:Maximize()
            self.IsMaximized = not self.IsMaximized
            
            if self.IsMaximized then
                self._OriginalSize = self.MainFrame.Size
                self._OriginalPos = self.MainFrame.Position
                
                local viewport = APEX._SERVICES.Workspace.CurrentCamera.ViewportSize
                AnimationSystem:Play(self.MainFrame, 0.3, {
                    Size = UDim2.fromOffset(viewport.X - 40, viewport.Y - 40),
                    Position = UDim2.fromOffset(20, 20),
                }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            else
                AnimationSystem:Play(self.MainFrame, 0.3, {
                    Size = self._OriginalSize,
                    Position = self._OriginalPos,
                }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
            
            Sidebar.Visible = true
            ContentArea.Visible = true
        end
        
        function Window:Close()
            if self.IsDestroyed then return end
            self.IsDestroyed = true
            
            -- Animação de saída
            AnimationSystem:Play(self.MainFrame, 0.2, {
                Size = UDim2.fromScale(0, 0),
                Position = UDim2.fromScale(0.5, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5),
            }, Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
                -- Limpar conexões
                for _, conn in ipairs(self._Connections) do
                    if conn then conn:Disconnect() end
                end
                
                self.ScreenGui:Destroy()
                
                -- Remover da lista global
                for i, w in ipairs(APEX.Windows) do
                    if w == self then
                        table.remove(APEX.Windows, i)
                        break
                    end
                end
            end)
        end
        
