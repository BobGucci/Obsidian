                    })
                    
                    if not info.Compact then
                        local SliderLabel = Creator:New("TextLabel", {
                            Size = UDim2.new(1, 0, 0, 20),
                            Text = info.Text or "Slider",
                            TextSize = 13,
                            Parent = SliderFrame,
                        })
                    end
                    
                    local Track = Creator:New("TextButton", {
                        AnchorPoint = info.Compact and Vector2.new(0, 0.5) or Vector2.new(0, 1),
                        Position = info.Compact and UDim2.fromOffset(0, 0.5) or UDim2.fromOffset(0, 1),
                        Size = UDim2.new(1, 0, 0, 6),
                        BackgroundColor3 = ApexLib.Scheme.Elevated,
                        Text = "",
                        Parent = SliderFrame,
                    })
                    Creator:ApplyCorner(Track, 3)
                    
                    local Fill = Creator:New("Frame", {
                        Size = UDim2.fromScale(0.5, 1),
                        BackgroundColor3 = ApexLib.Scheme.Primary,
                        Parent = Track,
                    })
                    Creator:ApplyCorner(Fill, 3)
                    
                    local ValueLabel = Creator:New("TextLabel", {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromScale(0.5, 0.5),
                        Size = UDim2.fromOffset(40, 16),
                        BackgroundTransparency = 1,
                        Text = tostring(Slider.Value),
                        TextSize = 12,
                        Parent = Track,
                    })
                    
                    function Slider:SetValue(value)
                        value = Utils:Clamp(value, Slider.Min, Slider.Max)
                        Slider.Value = value
                        
                        local percent = (value - Slider.Min) / (Slider.Max - Slider.Min)
                        Fill.Size = UDim2.fromScale(percent, 1)
                        ValueLabel.Text = tostring(Utils:Round(value, info.Rounding or 0))
                        
                        Utils:SafeCallback(Slider.Callback, value)
                    end
                    
                    -- Input handling
                    local dragging = false
                    
                    Track.InputBegan:Connect(function(input)
                        if Utils:IsClickInput(input) then
                            dragging = true
                            
                            local function update()
                                local absPos = Track.AbsolutePosition.X
                                local absSize = Track.AbsoluteSize.X
                                local mouseX = ApexLib.Services.UserInputService:GetMouseLocation().X
                                
                                local percent = Utils:Clamp((mouseX - absPos) / absSize, 0, 1)
                                local value = Slider.Min + (percent * (Slider.Max - Slider.Min))
                                
                                Slider:SetValue(value)
                            end
                            
                            update()
                            
                            local connection
                            connection = ApexLib.Services.RunService.RenderStepped:Connect(function()
                                if not dragging then
                                    connection:Disconnect()
                                    return
                                end
                                update()
                            end)
                        end
                    end)
                    
                    ApexLib.Services.UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
                           input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)
                    
                    Slider:SetValue(Slider.Value)
                    return Slider
                end
                
                function Groupbox:AddDropdown(info)
                    local Dropdown = {
                        Value = info.Multi and {} or nil,
                        Values = info.Values or {},
                        Multi = info.Multi or false,
                        Callback = info.Callback,
                    }
                    
                    local DropdownFrame = Creator:New("Frame", {
                        Size = UDim2.new(1, 0, 0, info.Text and 64 or 40),
                        BackgroundTransparency = 1,
                        Parent = ElementsContainer,
                    })
                    
                    if info.Text then
                        local DropdownLabel = Creator:New("TextLabel", {
                            Size = UDim2.new(1, 0, 0, 20),
                            Text = info.Text,
                            TextSize = 13,
                            Parent = DropdownFrame,
                        })
                    end
                    
                    local DropdownButton = Creator:New("TextButton", {
                        AnchorPoint = Vector2.new(0, 1),
                        Position = UDim2.fromScale(0, 1),
                        Size = UDim2.new(1, 0, 0, 36),
                        BackgroundColor3 = ApexLib.Scheme.Elevated,
                        Text = "---",
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = DropdownFrame,
                    })
                    Creator:ApplyCorner(DropdownButton)
                    Creator:ApplyStroke(DropdownButton)
                    
                    Creator:New("UIPadding", {
                        PaddingLeft = UDim.new(0, 12),
                        PaddingRight = UDim.new(0, 12),
                        Parent = DropdownButton,
                    })
                    
                    -- Menu dropdown (simplificado)
                    local Menu = Creator:New("Frame", {
                        Position = UDim2.fromOffset(0, 40),
                        Size = UDim2.new(1, 0, 0, 0),
                        AutomaticSize = Enum.AutomaticSize.Y,
                        BackgroundColor3 = ApexLib.Scheme.Surface,
                        BorderSizePixel = 0,
                        Visible = false,
                        ZIndex = 10,
                        Parent = DropdownFrame,
                    })
                    Creator:ApplyCorner(Menu)
                    Creator:ApplyStroke(Menu)
                    Creator:ApplyShadow(Menu, 0.3)
                    
                    local MenuList = Creator:New("UIListLayout", {
                        Padding = UDim.new(0, 2),
                        Parent = Menu,
                    })
                    
                    Creator:New("UIPadding", {
                        PaddingTop = UDim.new(0, 4),
                        PaddingBottom = UDim.new(0, 4),
                        Parent = Menu,
                    })
                    
                    local function RefreshOptions()
                        -- Limpar existentes
                        for _, child in ipairs(Menu:GetChildren()) do
                            if child:IsA("TextButton") then
                                child:Destroy()
                            end
                        end
                        
                        for _, value in ipairs(Dropdown.Values) do
                            local Option = Creator:New("TextButton", {
                                Size = UDim2.new(1, 0, 0, 32),
                                BackgroundColor3 = ApexLib.Scheme.Surface,
                                Text = tostring(value),
                                TextXAlignment = Enum.TextXAlignment.Left,
                                Parent = Menu,
                            })
                            
                            Creator:New("UIPadding", {
                                PaddingLeft = UDim.new(0, 12),
                                Parent = Option,
                            })
                            
                            Option.MouseEnter:Connect(function()
                                TweenService:Create(Option, TweenInfo.new(0.15), {
                                    BackgroundColor3 = ApexLib.Scheme.Elevated,
                                }):Play()
                            end)
                            
                            Option.MouseLeave:Connect(function()
                                TweenService:Create(Option, TweenInfo.new(0.15), {
                                    BackgroundColor3 = ApexLib.Scheme.Surface,
                                }):Play()
                            end)
                            
                            Option.MouseButton1Click:Connect(function()
                                if Dropdown.Multi then
                                    Dropdown.Value[value] = not Dropdown.Value[value]
                                else
                                    Dropdown.Value = value
                                    Menu.Visible = false
                                end
                                Dropdown:UpdateDisplay()
                                Utils:SafeCallback(Dropdown.Callback, Dropdown.Value)
                            end)
                        end
                    end
                    
                    function Dropdown:UpdateDisplay()
                        if Dropdown.Multi then
                            local selected = {}
                            for k, v in pairs(Dropdown.Value) do
                                if v then table.insert(selected, k) end
                            end
                            DropdownButton.Text = #selected > 0 and table.concat(selected, ", ") or "---"
                        else
                            DropdownButton.Text = Dropdown.Value and tostring(Dropdown.Value) or "---"
                        end
                    end
                    
                    DropdownButton.MouseButton1Click:Connect(function()
                        Menu.Visible = not Menu.Visible
                        if Menu.Visible then
                            RefreshOptions()
                        end
                    end)
                    
                    Dropdown:UpdateDisplay()
                    return Dropdown
                end
                
                -- Adicionar outros elementos aqui (Input, Button, ColorPicker, etc.)
                
                return Groupbox
            end
            
            TabButton.MouseButton1Click:Connect(function()
                Tab:Activate()
            end)
            
            table.insert(Window.Tabs, Tab)
            
            -- Auto-ativar primeira aba
            if #Window.Tabs == 1 then
                Tab:Activate()
            end
            
            return Tab
        end
        
        --// Funcionalidades da Janela
        function Window:Minimize()
            Window.IsMinimized = true
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                Size = UDim2.fromOffset(MainFrame.Size.X.Offset, 48),
            }):Play()
        end
        
        function Window:Maximize()
            Window.IsMaximized = not Window.IsMaximized
            local targetSize = Window.IsMaximized and UDim2.fromOffset(
                ApexLib.Services.Workspace.CurrentCamera.ViewportSize.X - 40,
                ApexLib.Services.Workspace.CurrentCamera.ViewportSize.Y - 40
            ) or Window.Size
            
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                Size = targetSize,
                Position = Window.IsMaximized and UDim2.fromOffset(20, 20) or Window.Position,
            }):Play()
        end
        
        function Window:Close()
            TweenService:Create(MainFrame, TweenInfo.new(0.2), {
                Size = UDim2.fromScale(0, 0),
                Position = UDim2.fromScale(0.5, 0.5),
            }):Play()
            
            task.delay(0.2, function()
                ScreenGui:Destroy()
            end)
        end
        
        --// Dragging System (Melhorado)
        local dragging = false
        local dragStart, startPos
        
        TitleBar.InputBegan:Connect(function(input)
            if Utils:IsClickInput(input) then
                dragging = true
                dragStart = input.Position
                startPos = MainFrame.Position
            end
        end)
        
        ApexLib.Services.UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
        
        ApexLib.Services.UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        --// Resizing (Se habilitado)
        if config.Resizable then
            local ResizeHandle = Creator:New("TextButton", {
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.fromScale(1, 1),
                Size = UDim2.fromOffset(20, 20),
                BackgroundTransparency = 1,
                Text = "",
                Parent = MainFrame,
            })
            
            local resizing = false
            local resizeStart, startSize
            
            ResizeHandle.InputBegan:Connect(function(input)
                if Utils:IsClickInput(input) then
                    resizing = true
                    resizeStart = input.Position
                    startSize = MainFrame.Size
                end
            end)
            
            ApexLib.Services.UserInputService.InputChanged:Connect(function(input)
                if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = input.Position - resizeStart
                    local newSize = UDim2.fromOffset(
                        math.max(Window.MinSize.X, startSize.X.Offset + delta.X),
                        math.max(Window.MinSize.Y, startSize.Y.Offset + delta.Y)
                    )
                    MainFrame.Size = newSize
                end
            end)
            
            ApexLib.Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    resizing = false
                end
            end)
        end
        
        ApexLib.CurrentWindow = Window
        table.insert(ApexLib.Windows, Window)
        
        return Window
    end
end
ApexLib.Window = WindowSystem

--// Sistema de Notificações Moderno
local NotificationSystem = {}
do
    function NotificationSystem:Notify(info)
        info = info or {}
        
        local Notification = {
            Title = info.Title or "Notification",
            Description = info.Description or "",
            Type = info.Type or "Info", -- Info, Success, Warning, Error
            Duration = info.Duration or 5,
            Callback = info.Callback,
        }
        
        -- Criar notificação com animações suaves
        -- (Implementação similar ao Window mas simplificada)
        
        return Notification
    end
    
    function NotificationSystem:Success(description)
        return self:Notify({ Type = "Success", Description = description, Duration = 3 })
    end
    
    function NotificationSystem:Error(description)
        return self:Notify({ Type = "Error", Description = description, Duration = 5 })
    end
end
ApexLib.Notify = NotificationSystem

--// Exportação
getgenv().ApexLib = ApexLib
return ApexLib
