local CacheSystem = {}
do
    function CacheSystem:GetIcon(name, size)
        local cacheKey = string.format("%s_%d", tostring(name), size or 24)
        
        if APEX._SYSTEMS.Cache.Icons[cacheKey] then
            return APEX._SYSTEMS.Cache.Icons[cacheKey]
        end
        
        -- Criar novo ícone (placeholder - integrar com sistema real de ícones)
        local iconData = {
            Name = name,
            Size = size or 24,
            URL = "",
            Loaded = false,
        }
        
        APEX._SYSTEMS.Cache.Icons[cacheKey] = iconData
        return iconData
    end
    
    function CacheSystem:StoreTween(id, tween)
        APEX._SYSTEMS.Cache.Tweens[id] = tween
    end
    
    function CacheSystem:GetTween(id)
        return APEX._SYSTEMS.Cache.Tweens[id]
    end
    
    function CacheSystem:ClearOld(maxAge)
        maxAge = maxAge or 300 -- 5 minutos
        local now = tick()
        
        for id, data in pairs(APEX._SYSTEMS.Cache.Instances) do
            if now - data.Time > maxAge then
                APEX._SYSTEMS.Cache.Instances[id] = nil
            end
        end
    end
    
    function CacheSystem:StoreInstance(id, instance)
        APEX._SYSTEMS.Cache.Instances[id] = {
            Instance = instance,
            Time = tick(),
        }
    end
end
APEX.Cache = CacheSystem

