// CRIADOR DE INSTÂNCIAS (Factory Pattern)
// =============================================================================

local Creator = {}
do
    local Templates = {
        Frame = {
            BackgroundColor3 = APEX._THEME.Surface,
            BorderSizePixel = 0,
        },
        TextLabel = {
            FontFace = Font.fromEnum(Enum.Font.Gotham),
            TextColor3 = APEX._THEME.TextPrimary,
            TextSize = 14,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            RichText = true,
        },
        TextButton = {
            FontFace = Font.fromEnum(Enum.Font.GothamMedium),
            TextColor3 = APEX._THEME.TextPrimary,
            TextSize = 14,
            AutoButtonColor = false,
            BorderSizePixel = 0,
        },
        TextBox = {
            FontFace = Font.fromEnum(Enum.Font.Gotham),
            TextColor3 = APEX._THEME.TextPrimary,
            TextSize = 14,
            ClearTextOnFocus = false,
            BorderSizePixel = 0,
        },
        ImageLabel = {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        },
        ImageButton = {
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            BorderSizePixel = 0,
        },
        ScrollingFrame = {
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = APEX._THEME.Border,
        },
    }
    
    function Creator:New(className, properties)
        -- Criar instância
        local success, instance = pcall(Instance.new, className)
        if not success or not instance then
            APEX.Error:Log("ERROR", "Creator", "Falha ao criar instância: " .. tostring(className))
            return nil
        end
        
        -- Aplicar template
        local template = Templates[className]
        if template then
            for prop, value in pairs(template) do
                local setSuccess = pcall(function()
                    instance[prop] = value
                end)
                if not setSuccess then
                    APEX.Error:Log("WARN", "Creator", string.format("Falha ao aplicar %s.%s", className, prop))
                end
            end
        end
        
        -- Aplicar propriedades customizadas
        properties = properties or {}
        for prop, value in pairs(properties) do
            if prop ~= "Parent" then
                local setSuccess, err = pcall(function()
                    instance[prop] = value
                end)
                if not setSuccess then
                    APEX.Error:Log("WARN", "Creator", string.format("Falha em %s.%s: %s", className, prop, tostring(err)))
                end
            end
        end
        
        -- Parent por último (melhor performance)
        if properties.Parent then
            instance.Parent = properties.Parent
        end
        
        return instance
    end
    
    function Creator:ApplyCorner(instance, radius)
        radius = radius or APEX._CONFIG.CORNER_RADIUS
        return self:New("UICorner", {
            CornerRadius = UDim.new(0, radius),
            Parent = instance,
        })
    end
    
    function Creator:ApplyStroke(instance, color, thickness, transparency)
        return self:New("UIStroke", {
            Color = color or APEX._THEME.Border,
            Thickness = thickness or 1,
            Transparency = transparency or 0,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = instance,
        })
    end
    
    function Creator:ApplyShadow(instance, intensity, offset, blur)
        if not APEX._CONFIG.USE_SHADOWS then return nil end
        
        intensity = intensity or 0.3
        offset = offset or UDim2.fromOffset(0, 4)
        blur = blur or 20
        
        local shadowHolder = self:New("Frame", {
            Name = "ShadowHolder",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5) + offset,
            Size = UDim2.new(1, blur * 2, 1, blur * 2),
            BackgroundTransparency = 1,
            ZIndex = instance.ZIndex - 1,
            Parent = instance.Parent,
        })
        
        local shadow = self:New("ImageLabel", {
            Name = "Shadow",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = "rbxassetid://6015897843", -- Shadow asset
            ImageColor3 = APEX._THEME.Shadow,
            ImageTransparency = 1 - intensity,
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(49, 49, 51, 51),
            SliceScale = blur / 50,
            Parent = shadowHolder,
        })
        
        -- Sincronizar movimento
        local connection
        connection = instance:GetPropertyChangedSignal("Parent"):Connect(function()
            if not instance.Parent then
                shadowHolder:Destroy()
                if connection then connection:Disconnect() end
            else
                shadowHolder.Parent = instance.Parent
            end
        end)
        
        table.insert(APEX._SYSTEMS.Connections, connection)
        
        return shadowHolder
    end
    
    function Creator:ApplyAcrylic(instance, intensity)
        if not APEX._CONFIG.USE_ACRYLIC then return nil end
        
        intensity = intensity or 0.15
        
        local acrylic = self:New("Frame", {
            Name = "Acrylic",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = APEX._THEME.Background,
            BackgroundTransparency = 1 - intensity,
            BorderSizePixel = 0,
            ZIndex = instance.ZIndex - 1,
            Parent = instance,
        })
        
        -- Noise texture overlay
        local noise = self:New("ImageLabel", {
            Name = "Noise",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = "rbxassetid://1316045210",
            ImageTransparency = 0.95,
            ScaleType = Enum.ScaleType.Tile,
            TileSize = UDim2.fromOffset(64, 64),
            ZIndex = 1,
            Parent = acrylic,
        })
        
        self:ApplyCorner(acrylic, APEX._CONFIG.CORNER_RADIUS)
        
        return acrylic
    end
    
    function Creator:ApplyGradient(instance, color1, color2, rotation, transparency)
        return self:New("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, color1 or APEX._THEME.Primary),
                ColorSequenceKeypoint.new(1, color2 or APEX._THEME.Secondary),
            }),
            Rotation = rotation or 0,
            Transparency = transparency or NumberSequence.new(0),
            Parent = instance,
        })
    end
    
    function Creator:CreateLayout(type, parent, config)
        config = config or {}
        
        if type == "List" then
            return self:New("UIListLayout", {
                Padding = config.Padding or UDim.new(0, 8),
                FillDirection = config.Direction or Enum.FillDirection.Vertical,
                HorizontalAlignment = config.HAlign or Enum.HorizontalAlignment.Left,
                VerticalAlignment = config.VAlign or Enum.VerticalAlignment.Top,
                SortOrder = config.Sort or Enum.SortOrder.LayoutOrder,
                Parent = parent,
            })
        elseif type == "Grid" then
            return self:New("UIGridLayout", {
                CellSize = config.CellSize or UDim2.fromOffset(100, 100),
                CellPadding = config.Padding or UDim.new(0, 8),
                FillDirection = config.Direction or Enum.FillDirection.Horizontal,
                Parent = parent,
            })
        elseif type == "Page" then
            return self:New("UIPageLayout", {
                Animated = config.Animated ~= false,
                Circular = config.Circular or false,
                EasingDirection = config.Easing or Enum.EasingDirection.Out,
                EasingStyle = config.Style or Enum.EasingStyle.Quart,
                TweenTime = config.Time or 0.3,
                Parent = parent,
            })
        elseif type == "Flex" then
            return self:New("UIFlexItem", {
                FlexMode = config.Mode or Enum.UIFlexMode.None,
                Parent = parent,
            })
        end
        
        return nil
    end
end
APEX.Creator = Creator

--// =============================================================================
// SISTEMA DE ANIMAÇÕES (Tween System Avançado)
// =============================================================================

local AnimationSystem = {}
do
    local ActiveTweens = {}
    local TweenQueue = {}
    
    function AnimationSystem:Create(object, duration, properties, easingStyle, easingDirection)
        if not object or not object.Parent then return nil end
        
        duration = duration or APEX._CONFIG.TWEEN_TIME
        easingStyle = easingStyle or APEX._CONFIG.TWEEN_STYLE
        easingDirection = easingDirection or APEX._CONFIG.TWEEN_DIRECTION
        
        -- Parar tweens existentes no mesmo objeto/propriedade
        self:Stop(object)
        
        local tweenInfo = TweenInfo.new(
            duration,
            easingStyle,
            easingDirection
        )
        
        local success, tween = pcall(function()
            return APEX._SERVICES.TweenService:Create(object, tweenInfo, properties)
        end)
        
        if not success or not tween then
            APEX.Error:Log("ERROR", "Animation", "Falha ao criar tween")
            return nil
        end
        
        -- Registrar
        ActiveTweens[object] = {
            Tween = tween,
            Properties = properties,
            StartTime = tick(),
        }
        
        -- Auto-limpeza
        tween.Completed:Connect(function()
            ActiveTweens[object] = nil
        end)
        
        return tween
    end
    
    function AnimationSystem:Play(object, duration, properties, callback)
        local tween = self:Create(object, duration, properties)
        if tween then
            tween:Play()
            if callback then
                tween.Completed:Connect(callback)
            end
        end
        return tween
    end
    
    function AnimationSystem:Stop(object)
        local data = ActiveTweens[object]
        if data and data.Tween then
            data.Tween:Cancel()
            ActiveTweens[object] = nil
        end
    end
    
    function AnimationSystem:StopAll()
        for object, data in pairs(ActiveTweens) do
            if data.Tween then
                data.Tween:Cancel()
            end
        end
        ActiveTweens = {}
    end
    
    --// Animações Predefinidas
    function AnimationSystem:FadeIn(object, duration)
        object.BackgroundTransparency = 1
        object.Visible = true
        return self:Play(object, duration or 0.2, {
            BackgroundTransparency = 0
        })
    end
    
    function AnimationSystem:FadeOut(object, duration, destroy)
        local tween = self:Play(object, duration or 0.2, {
            BackgroundTransparency = 1
        }, nil, nil, function()
            object.Visible = false
            if destroy then
                object:Destroy()
            end
        end)
        return tween
    end
    
    function AnimationSystem:ScaleIn(object, duration)
        object.Size = UDim2.fromScale(0.8, 0.8)
        object.Visible = true
        return self:Play(object, duration or 0.3, {
            Size = UDim2.fromScale(1, 1)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    
    function AnimationSystem:SlideIn(object, direction, duration)
        direction = direction or "Right"
        duration = duration or 0.3
        
        local originalPos = object.Position
        local startPos
        
        if direction == "Right" then
            startPos = originalPos + UDim2.fromOffset(50, 0)
        elseif direction == "Left" then
            startPos = originalPos - UDim2.fromOffset(50, 0)
        elseif direction == "Up" then
            startPos = originalPos - UDim2.fromOffset(0, 50)
        elseif direction == "Down" then
            startPos = originalPos + UDim2.fromOffset(0, 50)
        end
        
        object.Position = startPos
        object.Visible = true
        
        return self:Play(object, duration, {
            Position = originalPos
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end
    
    function AnimationSystem:Pulse(object, scale)
        scale = scale or 1.05
        local originalSize = object.Size
        
        self:Play(object, 0.15, { Size = originalSize * scale }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
            self:Play(object, 0.15, { Size = originalSize }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        end)
    end
    
    function AnimationSystem:Shake(object, intensity)
        intensity = intensity or 5
        local originalPos = object.Position
        
        for i = 1, 5 do
            local offset = UDim2.fromOffset(
                math.random(-intensity, intensity),
                math.random(-intensity, intensity)
            )
            self:Play(object, 0.05, { Position = originalPos + offset })
            task.wait(0.05)
        end
        
        object.Position = originalPos
    end
end
APEX.Animation = AnimationSystem

