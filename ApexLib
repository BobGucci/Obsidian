                function Group:AddSlider(config)
                    config = Utils:ValidateConfig(config, {
                        Text = "Slider",
                        Min = 0,
                        Max = 100,
                        Default = 50,
                        Rounding = 0,
                        Suffix = "",
                        Prefix = "",
                        Compact = false,
                        Callback = nil,
                    })
                    
                    local Slider = {
                        Value = config.Default,
                        Min = config.Min,
                        Max = config.Max,
                        Callback = config.Callback,
                    }
                    
                    local height = config.Compact and 32 or 56
                    local Frame = Creator:New("Frame", {
                        Size = UDim2.new(1, 0, 0, height),
                        BackgroundTransparency = 1,
                        Parent = ElementsContainer,
                    })
                    
                    local labelOffset = 0
                    if not config.Compact then
                        local Label = Creator:New("TextLabel", {
                            Size = UDim2.new(1, 0, 0, 20),
