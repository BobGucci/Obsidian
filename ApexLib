            VAlign = Enum.VerticalAlignment.Top,
        })
    end
    
    function NotificationSystem:Notify(config)
        self:Init()
        
        config = Utils:ValidateConfig(config, {
            Title = "Notificação",
            Description = "",
            Type = "Info", -- Info, Success, Warning, Error
            Duration = 5,
            Sound = false,
            Callback = nil,
            Actions = {}, -- { {Text = "OK", Callback = func} }
        })
        
        APEX._IDS.Notification += 1
        
        -- Cores por tipo
        local typeColors = {
            Info = APEX._THEME.Info,
            Success = APEX._THEME.Success,
            Warning = APEX._THEME.Warning,
            Error = APEX._THEME.Error,
        }
        
        local accentColor = typeColors[config.Type] or APEX._THEME.Info
        
        -- Criar notificação
        local NotifFrame = Creator:New("Frame", {
            Name = "Notif_" .. APEX._IDS.Notification,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = APEX._THEME.Surface,
            Parent = NotificationContainer,
        })
        Creator:ApplyCorner(NotifFrame, 10)
        Creator:ApplyShadow(NotifFrame, 0.3)
        
        -- Barra de cor indicadora
        local ColorBar = Creator:New("Frame", {
            Size = UDim2.fromOffset(4, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = accentColor,
            Parent = NotifFrame,
        })
        Creator:ApplyCorner(ColorBar, 2)
        
        -- Conteúdo
        local Content = Creator:New("Frame", {
            Position = UDim2.fromOffset(16, 0),
            Size = UDim2.new(1, -32, 1, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent = NotifFrame,
        })
        Creator:New("UIPadding", {
            PaddingTop = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            Parent = Content,
        })
        
        -- Título
        local Title = Creator:New("TextLabel", {
            Size = UDim2.new(1, -30, 0, 20),
            Text = config.Title,
            FontFace = Font.fromEnum(Enum.Font.GothamBold),
            Parent = Content,
        })
        
        -- Botão fechar
        local CloseBtn = Creator:New("TextButton", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.fromOffset(20, 20),
            BackgroundTransparency = 1,
            Text = "×",
            TextSize = 18,
            TextColor3 = APEX._THEME.TextMuted,
            Parent = Content,
        })
        
        -- Descrição
        local Description
        if config.Description and config.Description ~= "" then
            Description = Creator:New("TextLabel", {
                Position = UDim2.fromOffset(0, 24),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Text = config.Description,
                TextSize = 13,
                TextColor3 = APEX._THEME.TextSecondary,
                TextWrapped = true,
                Parent = Content,
            })
        end
        
        -- Timer bar
        local TimerBar = Creator:New("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 3),
            BackgroundColor3 = accentColor,
            BackgroundTransparency = 0.5,
            Parent = NotifFrame,
        })
        
        -- Animação de entrada
        NotifFrame.Position = UDim2.fromOffset(350, 0)
        AnimationSystem:Play(NotifFrame, 0.4, {
            Position = UDim2.fromOffset(0, 0),
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        -- Timer animation
        local timerTween = AnimationSystem:Play(TimerBar, config.Duration, {
            Size = UDim2.new(0, 0, 0, 3),
        }, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
        
        -- Função de destruição
        local function destroy()
            AnimationSystem:Play(NotifFrame, 0.3, {
                Position = UDim2.fromOffset(350, 0),
                BackgroundTransparency = 1,
            }, Enum.EasingStyle.Quart, Enum.EasingDirection.In, function()
                NotifFrame:Destroy()
                -- Remover da lista
                for i, n in ipairs(ActiveNotifications) do
                    if n.Frame == NotifFrame then
                        table.remove(ActiveNotifications, i)
                        break
                    end
                end
            end)
        end
        
        CloseBtn.MouseButton1Click:Connect(destroy)
        
        -- Auto destroy
        task.delay(config.Duration, destroy)
        
        -- Limitar quantidade
        table.insert(ActiveNotifications, 1, { Frame = NotifFrame, Destroy = destroy })
        while #ActiveNotifications > APEX._CONFIG.MAX_NOTIFICATIONS do
            local oldest = ActiveNotifications[#ActiveNotifications]
            if oldest then
                oldest.Destroy()
            end
        end
        
        return { Destroy = destroy }
    end
    
    --// Helpers rápidos
    function NotificationSystem:Success(description, title)
        return self:Notify({
            Title = title or "Sucesso",
            Description = description,
            Type = "Success",
            Duration = 3,
        })
    end
    
    function NotificationSystem:Error(description, title)
        return self:Notify({
            Title = title or "Erro",
            Description = description,
            Type = "Error",
            Duration = 6,
        })
    end
    
    function NotificationSystem:Warning(description, title)
        return self:Notify({
            Title = title or "Aviso",
            Description = description,
            Type = "Warning",
            Duration = 5,
        })
    end
    
    function NotificationSystem:Info(description, title)
        return self:Notify({
            Title = title or "Informação",
            Description = description,
            Type = "Info",
            Duration = 4,
        })
    end
end
