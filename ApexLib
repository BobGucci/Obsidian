                        0, Utils:Clamp(newPos.Y.Offset, 0, viewport.Y - 100)
                    )
                    
                    MainFrame.Position = newPos
                end
            end)
            
            local releaseConnection = APEX._SERVICES.UserInputService.InputEnded:Connect(function(input)
                if Utils:IsClick(input) then
                    dragging = false
                end
            end)
            
