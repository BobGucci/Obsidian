local IconSystem = {}
do
    local LucideURL = "https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/"
    local CustomIcons = {}
    
    function IconSystem:GetIcon(name, size)
        size = size or 24
        
        -- Cache check
        local cacheKey = name .. "_" .. tostring(size)
        if ApexLib._Systems.IconCache[cacheKey] then
            return ApexLib._Systems.IconCache[cacheKey]
        end
        
        -- Sistema de fallback para ícones
        local iconData = {
            Url = "",
            Size = size,
            IsCustom = false,
        }
        
        -- Implementação de ícones via ImageLabel com recorte
        -- (Integração com sistema de spritesheet otimizado)
        
        ApexLib._Systems.IconCache[cacheKey] = iconData
        return iconData
    end
    
    function IconSystem:Preload(icons)
        -- Pré-carregamento paralelo
        for _, icon in ipairs(icons) do
            task.spawn(function()
                IconSystem:GetIcon(icon)
            end)
        end
    end
end
ApexLib.Icons = IconSystem

--// Sistema de Animações Avançado
local TweenSystem = {}
do
    local ActiveTweens = {}
    local TweenPool = {}
    
    function TweenSystem:Create(object, info, properties)
        -- Pool de tweens para performance
        local tween = TweenService:Create(object, info, properties)
        
        -- Gerenciamento automático
        local connection = tween.Completed:Connect(function()
            ActiveTweens[tween] = nil
        end)
        
        ActiveTweens[tween] = connection
        return tween
    end
    
    function TweenSystem:StopAll(object)
        for tween, connection in pairs(ActiveTweens) do
            if tween.Instance == object then
                tween:Cancel()
                connection:Disconnect()
                ActiveTweens[tween] = nil
            end
        end
    end
    
    function TweenSystem:BulkCreate(tweens)
        -- Criação paralela de múltiplos tweens
        local completed = 0
        local total = #tweens
        
        for _, tweenData in ipairs(tweens) do
            task.spawn(function()
                local tween = self:Create(tweenData.Object, tweenData.Info, tweenData.Properties)
                tween:Play()
                tween.Completed:Wait()
                completed += 1
            end)
        end
        
        repeat task.wait() until completed == total
    end
end
ApexLib.Tween = TweenSystem

--// Sistema de Registro (Memory Management)
local Registry = {}
do
    function Registry:Add(instance, properties)
        ApexLib._Systems.Registry[instance] = {
            Properties = properties,
            Created = tick(),
        }
    end
    
    function Registry:UpdateTheme()
        for instance, data in pairs(ApexLib._Systems.Registry) do
            if instance and instance.Parent then
                for prop, colorKey in pairs(data.Properties) do
                    if typeof(colorKey) == "string" then
                        instance[prop] = ApexLib.Scheme[colorKey] or instance[prop]
                    elseif typeof(colorKey) == "function" then
                        instance[prop] = colorKey()
                    end
                end
            else
                ApexLib._Systems.Registry[instance] = nil
            end
        end
    end
    
    function Registry:Clean()
        for instance, _ in pairs(ApexLib._Systems.Registry) do
            if instance and not instance.Parent then
                ApexLib._Systems.Registry[instance] = nil
            end
        end
    end
end
ApexLib.Registry = Registry

--// Utilitários
local Utils = {}
do
    function Utils:Round(num, decimals)
        local mult = 10 ^ (decimals or 0)
        return math.floor(num * mult + 0.5) / mult
    end
    
    function Utils:Clamp(value, min, max)
        return math.max(min, math.min(max, value))
    end
    
    function Utils:Lerp(a, b, t)
        return a + (b - a) * t
    end
    
    function Utils:Map(value, inMin, inMax, outMin, outMax)
        return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin
    end
    
    function Utils:GetTextBounds(text, font, size, width)
        local params = Instance.new("GetTextBoundsParams")
        params.Text = text
        params.Font = font
        params.Size = size
        params.Width = width or math.huge
        params.RichText = true
        
        return ApexLib.Services.TextService:GetTextBoundsAsync(params)
    end
    
    function Utils:SafeCallback(callback, ...)
        if typeof(callback) == "function" then
            local success, result = pcall(callback, ...)
            if not success then
                warn("[ApexLib] Callback error:", result)
            end
            return success, result
        end
        return false, nil
    end
    
    --// Sistema de Gradiente Dinâmico
    function Utils:CreateGradient(color1, color2, rotation)
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, color1),
            ColorSequenceKeypoint.new(1, color2),
        })
    end
    
    --// Verificador de Input
    function Utils:IsClickInput(input, includeRightClick)
        return (input.UserInputType == Enum.UserInputType.MouseButton1 or 
               (includeRightClick and input.UserInputType == Enum.UserInputType.MouseButton2) or
               input.UserInputType == Enum.UserInputType.Touch) and
               input.UserInputState == Enum.UserInputState.Begin
    end
end
ApexLib.Utils = Utils

--// Criador de Elementos UI
local Creator = {}
do
    local function ApplyProperties(instance, props)
        for prop, value in pairs(props) do
            if prop ~= "Parent" then
                instance[prop] = value
            end
        end
        return instance
    end
    
    function Creator:New(className, properties)
        local instance = Instance.new(className)
        
        -- Aplicar templates padrão
        if className == "Frame" then
            instance.BackgroundColor3 = ApexLib.Scheme.Surface
            instance.BorderSizePixel = 0
        elseif className == "TextLabel" or className == "TextButton" or className == "TextBox" then
            instance.FontFace = Font.fromEnum(Enum.Font.Gotham)
            instance.TextColor3 = ApexLib.Scheme.TextPrimary
            instance.TextSize = 14
            instance.BorderSizePixel = 0
            instance.BackgroundTransparency = 1
        elseif className == "ImageLabel" or className == "ImageButton" then
            instance.BackgroundTransparency = 1
            instance.BorderSizePixel = 0
        end
        
        ApplyProperties(instance, properties or {})
        
        if properties and properties.Parent then
            instance.Parent = properties.Parent
        end
        
        return instance
    end
    
    --// Efeito Acrylic (Vidro Fosco)
    function Creator:ApplyAcrylic(frame, intensity)
        if not ApexLib.Settings.UseAcrylic then return end
        
        intensity = intensity or 0.15
        
        local blur = Creator:New("ImageLabel", {
            Name = "AcrylicBlur",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = "rbxassetid://1316045210", -- Blur asset
            ImageColor3 = ApexLib.Scheme.Background,
            ImageTransparency = 1 - intensity,
            ScaleType = Enum.ScaleType.Stretch,
            Parent = frame,
        })
        
        local noise = Creator:New("ImageLabel", {
            Name = "AcrylicNoise",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = "rbxassetid://1316045210", -- Noise texture
            ImageTransparency = 0.95,
            ScaleType = Enum.ScaleType.Tile,
            TileSize = UDim2.fromOffset(64, 64),
            Parent = frame,
        })
        
        return blur, noise
    end
    
    --// Sistema de Sombras
    function Creator:ApplyShadow(frame, intensity, offset)
        if not ApexLib.Settings.UseShadows then return end
        
        intensity = intensity or 0.3
        offset = offset or UDim2.fromOffset(0, 4)
        
        local shadow = Creator:New("ImageLabel", {
            Name = "Shadow",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5) + offset,
            Size = UDim2.new(1, 20, 1, 20),
            BackgroundTransparency = 1,
            Image = "rbxassetid://1316045210", -- Shadow asset
            ImageColor3 = ApexLib.Scheme.Shadow,
            ImageTransparency = 1 - intensity,
            ScaleType = Enum.ScaleType.Stretch,
            ZIndex = frame.ZIndex - 1,
            Parent = frame.Parent,
        })
        
        -- Anexar shadow ao frame para gerenciamento
        frame:GetPropertyChangedSignal("Parent"):Connect(function()
            shadow.Parent = frame.Parent
        end)
        
        return shadow
    end
    
    --// Corner Radius Responsivo
    function Creator:ApplyCorner(instance, radius)
        radius = radius or ApexLib.Settings.CornerRadius
        
        local corner = Creator:New("UICorner", {
            CornerRadius = UDim.new(0, radius),
            Parent = instance,
        })
        
        return corner
    end
    
    --// Stroke Moderno
    function Creator:ApplyStroke(instance, color, thickness)
        local stroke = Creator:New("UIStroke", {
            Color = color or ApexLib.Scheme.Border,
            Thickness = thickness or 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = instance,
        })
        
        return stroke
    end
end
ApexLib.Creator = Creator

