local ThemeSystem = {}
do
    APEX._THEMES = {
        Default = APEX._THEME,
        Dark = Utils:DeepCopy(APEX._THEME),
        Light = {
            Background = Color3.fromRGB(245, 245, 250),
            Surface = Color3.fromRGB(255, 255, 255),
            SurfaceHover = Color3.fromRGB(240, 240, 245),
            Elevated = Color3.fromRGB(235, 235, 240),
            TextPrimary = Color3.fromRGB(30, 30, 35),
            TextSecondary = Color3.fromRGB(100, 100, 110),
            TextMuted = Color3.fromRGB(150, 150, 160),
            Border = Color3.fromRGB(220, 220, 230),
        },
        Midnight = {
            Background = Color3.fromRGB(2, 6, 23),
            Surface = Color3.fromRGB(15, 23, 42),
            Primary = Color3.fromRGB(99, 102, 241),
            Secondary = Color3.fromRGB(14, 165, 233),
        },
        Forest = {
            Background = Color3.fromRGB(6, 20, 10),
            Surface = Color3.fromRGB(20, 40, 25),
            Primary = Color3.fromRGB(34, 197, 94),
            Secondary = Color3.fromRGB(16, 185, 129),
        },
        Sunset = {
            Background = Color3.fromRGB(20, 10, 15),
            Surface = Color3.fromRGB(40, 25, 30),
            Primary = Color3.fromRGB(251, 113, 133),
            Secondary = Color3.fromRGB(251, 146, 60),
        },
    }
    
    function ThemeSystem:SetTheme(themeName)
        local theme = APEX._THEMES[themeName]
        if not theme then
            ErrorHandler:Log("ERROR", "Theme", "Tema não encontrado: " .. tostring(themeName))
            return false
        end
        
        -- Merge com tema base para garantir todas as cores
        APEX._THEME = Utils:MergeTables(APEX._THEMES.Default, theme)
        
        -- Atualizar todas as janelas abertas
        for _, window in ipairs(APEX.Windows) do
            if window and not window.IsDestroyed then
                self:UpdateWindowTheme(window)
            end
        end
        
        APEX.Error:Log("INFO", "Theme", "Tema alterado para: " .. themeName)
        return true
    end
    
    function ThemeSystem:UpdateWindowTheme(window)
        -- Atualizar cores recursivamente
        local function updateColors(instance)
            if not instance then return end
            
            for _, child in ipairs(instance:GetDescendants()) do
                if child:IsA("GuiObject") then
                    -- Verificar registry
                    local registry = APEX._SYSTEMS.Registry[child]
                    if registry then
                        for prop, colorKey in pairs(registry) do
                            if APEX._THEME[colorKey] then
                                child[prop] = APEX._THEME[colorKey]
                            end
                        end
                    end
                end
            end
        end
        
        updateColors(window.MainFrame)
    end
    
    function ThemeSystem:GetThemes()
        local list = {}
        for name, _ in pairs(APEX._THEMES) do
            table.insert(list, name)
        end
        return list
    end
    
    function ThemeSystem:CreateCustomTheme(name, colors)
        APEX._THEMES[name] = Utils:MergeTables(APEX._THEMES.Default, colors)
        return true
    end
end
APEX.Theme = ThemeSystem

--// =============================================================================
// SISTEMA DE SAVE/LOAD (Config Manager)
// =============================================================================

local SaveSystem = {}
do
    APEX._CONFIG_FOLDER = "APEX_Configs"
    
    function SaveSystem:GetFolderPath()
        if not isfolder then return nil end
        if not isfolder(APEX._CONFIG_FOLDER) then
            makefolder(APEX._CONFIG_FOLDER)
        end
        return APEX._CONFIG_FOLDER
    end
    
    function SaveSystem:Save(name, data)
        local folder = self:GetFolderPath()
        if not folder then return false end
        
        local path = folder .. "/" .. name .. ".json"
        local success, encoded = pcall(function()
            return APEX._SERVICES.HttpService:JSONEncode(data)
        end)
        
        if success then
            writefile(path, encoded)
            APEX.Notify:Success("Configuração salva: " .. name)
            return true
        else
            APEX.Notify:Error("Falha ao salvar configuração")
            return false
        end
    end
    
    function SaveSystem:Load(name)
        local folder = self:GetFolderPath()
        if not folder then return nil end
        
        local path = folder .. "/" .. name .. ".json"
        if not isfile(path) then return nil end
        
        local success, data = pcall(function()
            local content = readfile(path)
            return APEX._SERVICES.HttpService:JSONDecode(content)
        end)
        
        return success and data or nil
    end
    
    function SaveSystem:GetConfigs()
        local folder = self:GetFolderPath()
        if not folder then return {} end
        
        local files = listfiles(folder)
        local configs = {}
        
        for _, file in ipairs(files) do
            if file:match("%.json$") then
                local name = file:match("([^/\\]+)%.json$")
                table.insert(configs, name)
            end
        end
        
        return configs
    end
    
    function SaveSystem:Delete(name)
        local folder = self:GetFolderPath()
        if not folder then return false end
        
        local path = folder .. "/" .. name .. ".json"
        if isfile(path) then
            delfile(path)
            return true
        end
        return false
    end
    
    function SaveSystem:Export(data)
        local success, encoded = pcall(function()
            return APEX._SERVICES.HttpService:JSONEncode(data)
        end)
        return success and encoded or nil
    end
    
    function SaveSystem:Import(jsonString)
        local success, data = pcall(function()
            return APEX._SERVICES.HttpService:JSONDecode(jsonString)
        end)
        return success and data or nil
    end
end
APEX.SaveManager = SaveSystem

