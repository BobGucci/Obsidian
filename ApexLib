                        AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        Parent = Menu,
                    })
                    Creator:CreateLayout("List", MenuList, { Padding = UDim.new(0, 2) })
                    
                    -- Limitar altura
                    local maxItems = math.min(#config.Values, config.MaxVisible)
                    Menu.Size = UDim2.new(1, 0, 0, maxItems * 36 + 16)
                    
                    function Dropdown:Refresh()
                        -- Limpar
                        for _, child in ipairs(MenuList:GetChildren()) do
                            if child:IsA("TextButton") then child:Destroy() end
                        end
                        
                        -- Criar opções
                        for _, value in ipairs(self.Values) do
                            local OptionBtn = Creator:New("TextButton", {
                                Size = UDim2.new(1, 0, 0, 34),
                                BackgroundColor3 = APEX._THEME.Surface,
                                Text = tostring(value),
                                TextXAlignment = Enum.TextXAlignment.Left,
                                Parent = MenuList,
                            })
                            Creator:ApplyCorner(OptionBtn, 6)
                            
                            Creator:New("UIPadding", {
                                PaddingLeft = UDim.new(0, 12),
                                Parent = OptionBtn,
                            })
                            
                            -- Checkmark para multi
                            if self.Multi then
                                local isSelected = self.Value[value] == true
                                local Check = Creator:New("Frame", {
                                    AnchorPoint = Vector2.new(1, 0.5),
                                    Position = UDim2.new(1, -12, 0.5, 0),
                                    Size = UDim2.fromOffset(18, 18),
                                    BackgroundColor3 = isSelected and APEX._THEME.Primary or APEX._THEME.Elevated,
                                    Parent = OptionBtn,
                                })
                                Creator:ApplyCorner(Check, 4)
                            end
                            
                            OptionBtn.MouseEnter:Connect(function()
                                AnimationSystem:Play(OptionBtn, 0.15, {
                                    BackgroundColor3 = APEX._THEME.ElevatedHover,
                                })
                            end)
                            
                            OptionBtn.MouseLeave:Connect(function()
                                AnimationSystem:Play(OptionBtn, 0.15, {
                                    BackgroundColor3 = APEX._THEME.Surface,
                                })
                            end)
                            
                            OptionBtn.MouseButton1Click:Connect(function()
                                if self.Multi then
                                    self.Value[value] = not self.Value[value]
                                    self:UpdateDisplay()
                                else
                                    self.Value = value
                                    self:Close()
                                end
                                ErrorHandler:SafeCall(self.Callback, self.Value)
                            end)
                        end
                    end
                    
                    function Dropdown:UpdateDisplay()
                        if self.Multi then
                            local selected = {}
                            for k, v in pairs(self.Value) do
                                if v then table.insert(selected, k) end
                            end
                            DropdownBtn.Text = #selected > 0 and table.concat(selected, ", ") or "---"
                        else
                            DropdownBtn.Text = self.Value and tostring(self.Value) or "---"
                        end
                    end
                    
                    function Dropdown:Open()
                        self.IsOpen = true
                        Menu.Visible = true
                        AnimationSystem:Play(ArrowIcon, 0.2, { Rotation = 180 })
                        self:Refresh()
                    end
                    
                    function Dropdown:Close()
                        self.IsOpen = false
                        Menu.Visible = false
                        AnimationSystem:Play(ArrowIcon, 0.2, { Rotation = 0 })
                    end
                    
                    function Dropdown:Toggle()
                        if self.IsOpen then self:Close() else self:Open() end
                    end
                    
                    DropdownBtn.MouseButton1Click:Connect(function()
                        self:Toggle()
                    end)
                    
                    -- Fechar ao clicar fora
                    APEX._SERVICES.UserInputService.InputBegan:Connect(function(input)
                        if self.IsOpen and Utils:IsClick(input) then
                            local mousePos = APEX._SERVICES.UserInputService:GetMouseLocation()
                            local absPos = Menu.AbsolutePosition
                            local absSize = Menu.AbsoluteSize
                            
                            if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or
                               mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y then
                                self:Close()
                            end
                        end
                    end)
                    
                    Dropdown:UpdateDisplay()
                    table.insert(Group.Elements, Dropdown)
                    return Dropdown
                end
                
                function Group:AddButton(config)
                    config = Utils:ValidateConfig(config, {
                        Text = "Button",
                        Callback = nil,
                        Style = "Default", -- Default, Primary, Danger
                        Icon = nil,
                    })
                    
                    local Button = {
                        Callback = config.Callback,
                    }
                    
                    local Frame = Creator:New("Frame", {
                        Size = UDim2.new(1, 0, 0, 40),
                        BackgroundTransparency = 1,
                        Parent = ElementsContainer,
                    })
                    
                    local Btn = Creator:New("TextButton", {
                        Size = UDim2.fromScale(1, 1),
                        BackgroundColor3 = config.Style == "Primary" and APEX._THEME.Primary or 
                                           config.Style == "Danger" and APEX._THEME.Error or 
                                           APEX._THEME.Elevated,
                        Text = config.Text,
                        Parent = Frame,
                    })
                    Creator:ApplyCorner(Btn)
                    
                    if config.Icon then
                        local Icon = Creator:New("ImageLabel", {
                            Size = UDim2.fromOffset(18, 18),
                            Position = UDim2.fromOffset(12, 11),
                            Image = config.Icon,
                            ImageColor3 = config.Style == "Primary" and APEX._THEME.TextPrimary or APEX._THEME.TextSecondary,
                            Parent = Btn,
                        })
                        Btn.TextXAlignment = Enum.TextXAlignment.Left
                        Creator:New("UIPadding", { PaddingLeft = UDim.new(0, 38), Parent = Btn })
                    end
                    
                    -- Effects
                    Btn.MouseEnter:Connect(function()
                        local targetColor = config.Style == "Primary" and APEX._THEME.PrimaryLight or
                                          config.Style == "Danger" and APEX._THEME.Error or
                                          APEX._THEME.ElevatedHover
                        AnimationSystem:Play(Btn, 0.15, { BackgroundColor3 = targetColor })
                    end)
                    
                    Btn.MouseLeave:Connect(function()
                        local targetColor = config.Style == "Primary" and APEX._THEME.Primary or
                                          config.Style == "Danger" and APEX._THEME.Error or
                                          APEX._THEME.Elevated
                        AnimationSystem:Play(Btn, 0.15, { BackgroundColor3 = targetColor })
                    end)
                    
                    Btn.MouseButton1Down:Connect(function()
                        AnimationSystem:Play(Btn, 0.1, { Size = UDim2.fromScale(0.98, 0.95) })
                    end)
                    
                    Btn.MouseButton1Up:Connect(function()
                        AnimationSystem:Play(Btn, 0.1, { Size = UDim2.fromScale(1, 1) })
                    end)
                    
                    Btn.MouseButton1Click:Connect(function()
                        AnimationSystem:Pulse(Btn)
                        ErrorHandler:SafeCall(Button.Callback)
                    end)
                    
                    table.insert(Group.Elements, Button)
                    return Button
                end
                
                function Group:AddInput(config)
                    config = Utils:ValidateConfig(config, {
                        Text = "Input",
                        Default = "",
                        Placeholder = "Digite aqui...",
                        Numeric = false,
                        Finished = true,
                        ClearOnFocus = false,
                        Callback = nil,
                    })
                    
                    local Input = {
                        Value = config.Default,
                        Callback = config.Callback,
                    }
                    
                    local Frame = Creator:New("Frame", {
                        Size = UDim2.new(1, 0, 0, config.Text and 72 or 40),
                        BackgroundTransparency = 1,
                        Parent = ElementsContainer,
                    })
                    
                    if config.Text then
                        local Label = Creator:New("TextLabel", {
                            Size = UDim2.new(1, 0, 0, 20),
                            Text = config.Text,
                            TextSize = 13,
                            Parent = Frame,
                        })
                    end
                    
                    local InputBox = Creator:New("TextBox", {
                        Position = UDim2.fromOffset(0, config.Text and 28 or 0),
                        Size = UDim2.new(1, 0, 0, 40),
                        BackgroundColor3 = APEX._THEME.Elevated,
                        Text = config.Default,
                        PlaceholderText = config.Placeholder,
                        ClearTextOnFocus = config.ClearOnFocus,
                        Parent = Frame,
                    })
                    Creator:ApplyCorner(InputBox)
                    Creator:ApplyStroke(InputBox)
                    
                    Creator:New("UIPadding", {
                        PaddingLeft = UDim.new(0, 12),
                        PaddingRight = UDim.new(0, 12),
                        Parent = InputBox,
                    })
                    
                    -- Validação numérica
                    if config.Numeric then
                        InputBox:GetPropertyChangedSignal("Text"):Connect(function()
                            local text = InputBox.Text
                            if text ~= "" and not tonumber(text) then
                                InputBox.Text = text:gsub("[^%d%.%-]", "")
                            end
                        end)
                    end
                    
                    function Input:SetValue(value, silent)
                        self.Value = value
                        InputBox.Text = tostring(value)
                        if not silent then
                            ErrorHandler:SafeCall(self.Callback, value)
                        end
                    end
                    
                    if config.Finished then
                        InputBox.FocusLost:Connect(function()
                            self.Value = InputBox.Text
                            ErrorHandler:SafeCall(self.Callback, self.Value)
                        end)
                    else
                        InputBox:GetPropertyChangedSignal("Text"):Connect(function()
                            self.Value = InputBox.Text
                            ErrorHandler:SafeCall(self.Callback, self.Value)
                        end)
                    end
                    
                    -- Focus effects
                    InputBox.Focused:Connect(function()
                        AnimationSystem:Play(InputBox, 0.2, {
                            BackgroundColor3 = APEX._THEME.ElevatedHover,
                        })
                        Creator:ApplyStroke(InputBox, APEX._THEME.Primary, 2)
                    end)
                    
                    InputBox.FocusLost:Connect(function()
                        AnimationSystem:Play(InputBox, 0.2, {
                            BackgroundColor3 = APEX._THEME.Elevated,
                        })
                        Creator:ApplyStroke(InputBox, APEX._THEME.Border, 1)
                    end)
                    
                    table.insert(Group.Elements, Input)
                    return Input
                end
                
                -- Adicionar mais elementos: ColorPicker, KeyPicker, etc.
                
                table.insert(self.Groups, Group)
                return Group
            end
            
            TabButton.MouseButton1Click:Connect(function()
                Tab:Activate()
            end)
            
            table.insert(self.Tabs, Tab)
            
            -- Auto-ativar primeira aba
            if #self.Tabs == 1 then
                Tab:Activate()
            end
            
            return Tab
        end
        
        --// Keybind para toggle
        if config.Keybind then
            local keyConnection = APEX._SERVICES.UserInputService.InputBegan:Connect(function(input)
                if input.KeyCode == config.Keybind and not APEX._SERVICES.UserInputService:GetFocusedTextBox() then
                    self:Toggle()
                end
            end)
            table.insert(self._Connections, keyConnection)
        end
        
        -- Animação de abertura
        if config.AnimateOpen and config.AutoShow then
            MainFrame.Size = UDim2.fromScale(0, 0)
            MainFrame.Visible = true
            
            task.delay(0.1, function()
                AnimationSystem:Play(MainFrame, 0.4, {
                    Size = config.Size,
                }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end)
        else
            MainFrame.Visible = config.AutoShow
        end
        
        table.insert(APEX.Windows, self)
        APEX.ActiveWindow = self
        
        return self
    end
end
