--// SISTEMA DE ERROS E LOGGING
--// =============================================================================

local ErrorHandler = {}
do
    function ErrorHandler:Wrap(func, context)
        return function(...)
            local success, result = pcall(func, ...)
            if not success then
                self:Log("ERROR", context or "Unknown", result)
                return nil, result
            end
            return result
        end
    end
    
    function ErrorHandler:Log(level, context, message)
        local timestamp = os.date("%H:%M:%S")
        local prefix = string.format("[%s] [APEX-%s] [%s]:", timestamp, level, context)
        
        if level == "ERROR" then
            warn(prefix, message)
            -- Salvar em log interno para debug
            table.insert(APEX._SYSTEMS.Cache.Logs or {}, {Time = tick(), Level = level, Context = context, Message = message})
        elseif APEX._CONFIG.DEBUG_MODE then
            print(prefix, message)
        end
    end
    
    function ErrorHandler:Assert(condition, message, context)
        if not condition then
            self:Log("ERROR", context or "Assert", message or "Assertion failed")
            error("[APEX] " .. (message or "Assertion failed"), 2)
        end
        return condition
    end
    
    function ErrorHandler:SafeCall(func, ...)
        if type(func) ~= "function" then return nil end
        local success, result = pcall(func, ...)
        if not success then
            self:Log("ERROR", "Callback", result)
            return nil
        end
        return result
    end
end
APEX.Error = ErrorHandler

--// =============================================================================
--// UTILITÁRIOS MATEMÁTICOS E HELPERS
--// =============================================================================

local Utils = {}
do
    --// Matemática Avançada
    function Utils:Round(num, decimals)
        if type(num) ~= "number" then return 0 end
        decimals = decimals or 0
        local mult = 10 ^ decimals
        return math.floor(num * mult + 0.5) / mult
    end
    
    function Utils:Clamp(value, min, max)
        if type(value) ~= "number" then return min or 0 end
        return math.max(min or -math.huge, math.min(max or math.huge, value))
    end
    
    function Utils:Lerp(a, b, t)
        return a + (b - a) * Utils:Clamp(t, 0, 1)
    end
    
    function Utils:Map(value, inMin, inMax, outMin, outMax)
        return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin
    end
    
    function Utils:Easing(t, type)
        -- Easing functions avançadas
        type = type or "OutQuart"
        t = Utils:Clamp(t, 0, 1)
        
        if type == "OutQuart" then
            return 1 - (1 - t) ^ 4
        elseif type == "InOutQuart" then
            return t < 0.5 and 8 * t ^ 4 or 1 - (-2 * t + 2) ^ 4 / 2
        elseif type == "OutBack" then
            local c1, c3 = 1.70158, 2.70158
            return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
        elseif type == "OutElastic" then
            local c4 = (2 * math.pi) / 3
            return t == 0 and 0 or t == 1 and 1 or 2 ^ (-10 * t) * math.sin((t * 10 - 0.75) * c4) + 1
        end
        return t
    end
    
    --// Cores e Gradientes
    function Utils:ColorLerp(c1, c2, t)
        return Color3.new(
            Utils:Lerp(c1.R, c2.R, t),
            Utils:Lerp(c1.G, c2.G, t),
            Utils:Lerp(c1.B, c2.B, t)
        )
    end
    
    function Utils:HexToColor(hex)
        hex = hex:gsub("#", "")
        return Color3.fromRGB(
            tonumber(hex:sub(1, 2), 16),
            tonumber(hex:sub(3, 4), 16),
            tonumber(hex:sub(5, 6), 16)
        )
    end
    
    function Utils:ColorToHex(color)
        return string.format("#%02X%02X%02X", 
            math.floor(color.R * 255),
            math.floor(color.G * 255),
            math.floor(color.B * 255)
        )
    end
    
    --// Texto e Medidas
    function Utils:GetTextBounds(text, font, size, maxWidth)
        local success, bounds = pcall(function()
            local params = Instance.new("GetTextBoundsParams")
            params.Text = tostring(text or "")
            params.Font = font or Font.fromEnum(Enum.Font.Gotham)
            params.Size = size or 14
            params.Width = maxWidth or math.huge
            params.RichText = true
            
            return APEX._SERVICES.TextService:GetTextBoundsAsync(params)
        end)
        
        return success and bounds or Vector2.zero
    end
    
    function Utils:Truncate(text, maxLength, suffix)
        text = tostring(text or "")
        if #text <= maxLength then return text end
        suffix = suffix or "..."
        return text:sub(1, maxLength - #suffix) .. suffix
    end
    
    --// Tabelas
    function Utils:DeepCopy(orig)
        local copy
        if type(orig) == "table" then
            copy = {}
            for k, v in next, orig, nil do
                copy[Utils:DeepCopy(k)] = Utils:DeepCopy(v)
            end
            setmetatable(copy, Utils:DeepCopy(getmetatable(orig)))
        else
            copy = orig
        end
        return copy
    end
    
    function Utils:MergeTables(base, override)
        local result = Utils:DeepCopy(base or {})
        for k, v in pairs(override or {}) do
            if type(v) == "table" and type(result[k]) == "table" then
                result[k] = Utils:MergeTables(result[k], v)
            else
                result[k] = v
            end
        end
        return result
    end
    
    --// Input
    function Utils:IsLeftClick(input)
        return input and input.UserInputType == Enum.UserInputType.MouseButton1
    end
    
    function Utils:IsRightClick(input)
        return input and input.UserInputType == Enum.UserInputType.MouseButton2
    end
    
    function Utils:IsTouch(input)
        return input and input.UserInputType == Enum.UserInputType.Touch
    end
    
    function Utils:IsClick(input)
        return Utils:IsLeftClick(input) or Utils:IsTouch(input)
    end
    
    function Utils:IsKey(input, keyCode)
        return input and input.KeyCode == keyCode
    end
    
    --// Validação
    function Utils:ValidateConfig(config, template)
        config = config or {}
        template = template or {}
        
        local validated = {}
        for key, default in pairs(template) do
            if config[key] == nil then
                validated[key] = Utils:DeepCopy(default)
            else
                local expectedType = type(default)
                local actualType = type(config[key])
                
                if expectedType == actualType or expectedType == "nil" then
                    validated[key] = config[key]
                else
                    -- Tentar converter
                    if expectedType == "number" and actualType == "string" then
                        validated[key] = tonumber(config[key]) or default
                    elseif expectedType == "boolean" and actualType == "string" then
                        validated[key] = config[key]:lower() == "true"
                    else
                        validated[key] = Utils:DeepCopy(default)
                        APEX.Error:Log("WARN", "Config", string.format("Tipo inválido para '%s', usando padrão", key))
                    end
                end
            end
        end
        
        -- Adicionar extras não no template
        for key, value in pairs(config) do
            if validated[key] == nil then
                validated[key] = value
            end
        end
        
        return validated
    end
end
APEX.Utils = Utils

